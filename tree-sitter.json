{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "rbs",
      "camelcase": "Rbs",
      "scope": "source.ruby",
      "path": ".",
      "file-types": [
        "rbs"
      ],
      "highlights": [
        "queries/highlights.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.2.2",
    "license": "MIT",
    "description": "rbs grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-rbs"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
